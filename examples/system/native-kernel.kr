#![target("x86_64-unknown-none")]
#![no_std]
#![no_main]

@repr(C)
struct VgaCell {
  character: u8,
  color: u8,
}

unsafe fn write_cell(index: usize, character: u8, color: u8) {
  let cells: *mut VgaCell = pointer.from_address<VgaCell>(0xB8000)
  let cell: *mut VgaCell = cells.offset(index)
  cell.character = character
  cell.color = color
}

fn add(left: u32, right: u32) -> u32 {
  return left + right
}

@entry
pub extern "C" fn kernel_main() -> never {
  let answer: u32 = add(20, 22)
  if answer == 42 {
    unsafe {
      write_cell(0, 75, 15)
      write_cell(1, 117, 15)
      write_cell(2, 114, 15)
      write_cell(3, 97, 15)
      cpu.halt()
    }
  }
  unsafe { cpu.halt() }
}
