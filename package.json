{
  "name": "@kura-lang/compiler",
  "version": "1.0.0",
  "description": "Kura v1 compiler and complete CLI with package manager, standard library, formatter, tests, Security Shield, Kura.ai, hot reload, standalone builds, and a generic language server",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "bin": {
    "kr": "bin/kr.mjs"
  },
  "exports": {
    ".": "./lib/compiler.mjs",
    "./system": "./lib/system.mjs",
    "./system/source": "./lib/system-source.mjs",
    "./runtime/gpu": "./runtime/gpu.mjs",
    "./package.json": "./package.json",
    "./diagnostics": "./lib/diagnostics.mjs",
    "./security": "./lib/security.mjs"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "templates",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "kura",
    "compiler",
    "programming-language",
    "cli",
    "package-manager",
    "standard-library",
    "formatter",
    "test-runner",
    "language-server",
    "security",
    "diagnostics",
    "friendly-errors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kura-monster/kura.git"
  },
  "bugs": {
    "url": "https://github.com/kura-monster/kura/issues"
  },
  "homepage": "https://kr.klyn.site/docs",
  "scripts": {
    "test": "node test/smoke.mjs && node test/velocity.mjs && node test/diagnostics.mjs && node test/security.mjs && node test/system.mjs && node test/system-source.mjs",
    "test:security": "node test/security.mjs",
    "test:diagnostics": "node test/diagnostics.mjs",
    "test:system": "node test/system.mjs && node test/system-source.mjs",
    "check:package": "npm pack --dry-run --json",
    "prepack": "npm test"
  }
}
